@startuml use-case-diagram
' Use-Case-Diagramm Cyber Defenders (SRS Abschnitt 2.2)
' Autor: Dominik. Entwurf, vom Team zu bestaetigen.
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #1F2937
}
skinparam defaultFontName Arial

actor "Spieler" as Spieler

rectangle "Cyber Defenders" {
  usecase "Anmelden und registrieren" as Login #E5E7EB
  usecase "UC-01\nMission auswählen\n(3 SP)" as UC01
  usecase "UC-02\nFallakte lesen\n(2 SP)" as UC02
  usecase "UC-03\nLösung im Editor schreiben\n(8 SP)" as UC03
  usecase "UC-04\nLösung prüfen lassen\n(8 SP)" as UC04
  usecase "UC-05\nFortschritt speichern\n(3 SP)" as UC05
  usecase "UC-06\nFortschritt ansehen\n(5 SP)" as UC06
  usecase "UC-07\nHinweis anfordern\n(2 SP)" as UC07
  usecase "UC-08\nCode ausführen\n(5 SP)" as UC08
}

Spieler --> Login
Spieler --> UC01
Spieler --> UC02
Spieler --> UC03
Spieler --> UC04
Spieler --> UC06

UC07 .up.> UC03 : <<extend>>\n(Spieler kommt nicht weiter)
UC08 .up.> UC03 : <<extend>>\n(Spieler testet seinen Code)
UC05 .up.> UC04 : <<extend>>\n(Lösung korrekt)

note bottom of Login
  Grau: zählt nicht zu den fünf
  High-Level-Use-Cases (Vorgabe Task 03)
end note
@enduml
